---
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
---

<footer
  class="mx-auto mb-8 flex w-full max-w-3xl flex-col items-center justify-center gap-y-4 px-4 sm:mb-4"
>
  <!-- Pixel art dev -->
  <div class="flex flex-col items-center gap-2">
    <img
      src="/static/photos/pixel-dev.jpg"
      alt="Pixel art developer"
      class="h-16 w-auto rounded opacity-80 transition-opacity hover:opacity-100"
    />
  </div>

  <div class="flex w-full flex-col items-center justify-center gap-y-2 sm:flex-row sm:justify-between">
    <div class="flex flex-wrap items-center justify-center gap-x-2 text-center">
      <span class="text-muted-foreground text-sm">
        &copy; {new Date().getFullYear()} Leonardo Otero. All rights reserved.
      </span>
    </div>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
</footer>
