---
/**
 * Animated AI background for wide monitors.
 * Shows floating AI terms, mini charts, robot paths, Sankey diagrams,
 * hydroponics elements, and market tickers in the margins.
 * Only visible on screens wider than the main content (xl+).
 */
---

<div
  class="pointer-events-none fixed inset-0 z-0 hidden overflow-hidden xl:block"
  aria-hidden="true"
  id="ai-background"
>
  <!-- ═══ LEFT SIDE ═══ -->

  <!-- Sankey Diagram: AI-Controlled Hydroponics -->
  <svg class="ab-sankey absolute left-4 top-[15%] h-[340px] w-[220px] opacity-[0.09]" viewBox="0 0 220 340" fill="none">
    <!-- Nodes -->
    <rect x="10" y="10" width="80" height="28" rx="6" stroke="currentColor" stroke-width="1.2"/>
    <text x="50" y="28" text-anchor="middle" fill="currentColor" font-size="8" font-family="monospace">Sensors</text>
    <rect x="10" y="60" width="80" height="28" rx="6" stroke="currentColor" stroke-width="1.2"/>
    <text x="50" y="78" text-anchor="middle" fill="currentColor" font-size="8" font-family="monospace">pH / EC / Temp</text>
    <rect x="130" y="35" width="80" height="28" rx="6" stroke="currentColor" stroke-width="1.2"/>
    <text x="170" y="53" text-anchor="middle" fill="currentColor" font-size="8" font-family="monospace">Data Lake</text>
    <rect x="60" y="120" width="100" height="32" rx="8" stroke="currentColor" stroke-width="1.5"/>
    <text x="110" y="140" text-anchor="middle" fill="currentColor" font-size="9" font-weight="bold" font-family="monospace">ML Model</text>
    <rect x="10" y="190" width="80" height="28" rx="6" stroke="currentColor" stroke-width="1.2"/>
    <text x="50" y="208" text-anchor="middle" fill="currentColor" font-size="8" font-family="monospace">Nutrient Mix</text>
    <rect x="130" y="190" width="80" height="28" rx="6" stroke="currentColor" stroke-width="1.2"/>
    <text x="170" y="208" text-anchor="middle" fill="currentColor" font-size="8" font-family="monospace">Light Cycle</text>
    <rect x="60" y="260" width="100" height="32" rx="8" stroke="currentColor" stroke-width="1.5"/>
    <text x="110" y="280" text-anchor="middle" fill="currentColor" font-size="9" font-weight="bold" font-family="monospace">Growth</text>
    <!-- Sankey flows -->
    <path d="M90,24 C110,24 120,49 130,49" stroke="currentColor" stroke-width="6" opacity="0.15"/>
    <path d="M90,74 C110,74 120,49 130,49" stroke="currentColor" stroke-width="4" opacity="0.12"/>
    <path d="M170,63 L170,80 C170,100 130,110 110,120" stroke="currentColor" stroke-width="5" opacity="0.15"/>
    <path d="M50,38 C50,70 80,100 90,120" stroke="currentColor" stroke-width="4" opacity="0.12"/>
    <path d="M80,152 C60,170 50,180 50,190" stroke="currentColor" stroke-width="5" opacity="0.15"/>
    <path d="M140,152 C160,170 170,180 170,190" stroke="currentColor" stroke-width="4" opacity="0.12"/>
    <path d="M50,218 C50,240 90,250 100,260" stroke="currentColor" stroke-width="4" opacity="0.12"/>
    <path d="M170,218 C170,240 130,250 120,260" stroke="currentColor" stroke-width="4" opacity="0.12"/>
    <!-- Animated data particles -->
    <circle r="2" fill="currentColor" opacity="0.3">
      <animateMotion dur="3s" repeatCount="indefinite" path="M50,38 C50,70 80,100 90,120"/>
    </circle>
    <circle r="2" fill="currentColor" opacity="0.3">
      <animateMotion dur="4s" repeatCount="indefinite" path="M170,63 L170,80 C170,100 130,110 110,120"/>
    </circle>
    <circle r="1.5" fill="currentColor" opacity="0.25">
      <animateMotion dur="3.5s" repeatCount="indefinite" path="M80,152 C60,170 50,180 50,190"/>
    </circle>
  </svg>

  <!-- Robot following path (left) -->
  <svg class="ab-robot absolute left-[140px] top-[58%] h-[200px] w-[120px] opacity-[0.08]" viewBox="0 0 120 200" fill="none">
    <path d="M10,180 C10,100 60,120 60,40 C60,0 110,20 110,80 C110,140 60,100 60,180" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3" opacity="0.4"/>
    <!-- Robot icon -->
    <g opacity="0.6">
      <animateMotion dur="8s" repeatCount="indefinite" path="M10,180 C10,100 60,120 60,40 C60,0 110,20 110,80 C110,140 60,100 60,180"/>
      <rect x="-8" y="-10" width="16" height="14" rx="3" stroke="currentColor" stroke-width="1.2" fill="none"/>
      <circle cx="-3" cy="-4" r="1.5" fill="currentColor"/>
      <circle cx="3" cy="-4" r="1.5" fill="currentColor"/>
      <line x1="-4" y1="0" x2="4" y2="0" stroke="currentColor" stroke-width="0.8"/>
      <line x1="0" y1="4" x2="0" y2="8" stroke="currentColor" stroke-width="1"/>
      <line x1="-5" y1="6" x2="-8" y2="2" stroke="currentColor" stroke-width="0.8"/>
      <line x1="5" y1="6" x2="8" y2="2" stroke="currentColor" stroke-width="0.8"/>
    </g>
  </svg>

  <!-- Mini chart (left, bottom) -->
  <svg class="ab-chart-1 absolute left-8 bottom-[25%] h-[60px] w-[100px] opacity-[0.08]" viewBox="0 0 100 60" fill="none">
    <rect x="0" y="0" width="100" height="60" rx="6" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
    <polyline points="5,50 15,42 25,45 35,30 45,35 55,20 65,25 75,15 85,18 95,8" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
    <text x="5" y="10" fill="currentColor" font-size="5" font-family="monospace" opacity="0.5">BTC/USD</text>
  </svg>

  <!-- ═══ RIGHT SIDE ═══ -->

  <!-- Market Ticker (right side, scrolling up) -->
  <div class="ab-ticker absolute right-6 top-[10%] flex flex-col gap-2.5 opacity-[0.16] font-mono text-[9px]">
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="#A2AAAD"><path d="M18.7 19.5c-1.1 1.4-2.3 2.8-4 2.8s-2.2-.9-4.2-.9-2.6.9-4.2.9-2.7-1.3-3.8-2.8C1 17.2-.2 13.1 1.3 10.4c.7-1.4 2-2.3 3.5-2.3 1.7 0 2.7.9 4.2.9s1.8-.9 4.2-.9c1.2 0 2.7.5 3.6 1.6-3.2 1.7-2.6 6.2.6 7.4-.7 1.6-1.1 2.3-1.7 3.1zM15.7 2.5c-2.5.2-4.4 2.7-4.1 4.9 2.3.2 4.4-2.4 4.1-4.9z"/></svg>
      AAPL <span class="text-green-400">▲2.4%</span> <span class="text-green-400">$198</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="#76B900"><path d="M8.9 11.6V9.4c4-.3 6.8 2 6.8 2s-2 3.5-6.8 3v-1.5l-3-1.6 3-1.6zm0-3.5v-1c5.5-.4 9.2 3.6 9.2 3.6s-3.3 5.2-9.2 4.5v-1c4.2.5 6.8-3.5 6.8-3.5s-2.6-3-6.8-2.6zM8.9 5V3.5C16 3 20.5 8.8 20.5 8.8s-4.5 6.5-11.6 5.7V13c5.5.6 9-4.2 9-4.2S14.4 4.5 8.9 5zM3.5 10l2.6 1.5v-3L3.5 10z"/></svg>
      NVDA <span class="text-green-400">▲5.1%</span> <span class="text-green-400">$892</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="#E82127"><path d="M12 2L1 21h3.5L12 7l7.5 14H23L12 2zm0 8l-4 7.5h8L12 10z"/></svg>
      TSLA <span class="text-red-400">▼1.2%</span> <span class="text-red-400">$245</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none"><rect x="1" y="1" width="10" height="10" fill="#F25022"/><rect x="13" y="1" width="10" height="10" fill="#7FBA00"/><rect x="1" y="13" width="10" height="10" fill="#00A4EF"/><rect x="13" y="13" width="10" height="10" fill="#FFB900"/></svg>
      MSFT <span class="text-green-400">▲0.8%</span> <span class="text-green-400">$425</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="#F7931A"><circle cx="12" cy="12" r="10" opacity="0.2"/><path d="M15.5 10.5c.3-2-1.2-3-3.3-3.7l.7-2.8-1.7-.4-.7 2.7c-.4-.1-.9-.2-1.4-.3l.7-2.7-1.7-.4-.7 2.8c-.3-.1-.7-.2-1-.3l-2.3-.6-.4 1.8s1.2.3 1.2.3c.7.2.8.6.8 1l-.8 3.3c0 .1.1.1.1.2h-.1l-1.2 4.7c-.1.2-.3.6-.8.4 0 0-1.2-.3-1.2-.3l-.8 1.9 2.2.5c.4.1.8.2 1.2.3l-.7 2.8 1.7.4.7-2.8c.5.1.9.2 1.4.3l-.7 2.8 1.7.4.7-2.8c2.9.5 5.1.3 6-2.3.7-2.1 0-3.3-1.5-4.1 1.1-.3 1.9-1 2.1-2.5zm-3.8 5.3c-.5 2.1-4.2 1-5.4.7l1-3.9c1.2.3 5 .9 4.5 3.2zm.5-5.4c-.5 1.9-3.5.9-4.5.7l.9-3.5c1 .3 4.1.7 3.6 2.8z"/></svg>
      BTC <span class="text-green-400">▲3.7%</span> <span class="text-green-400">$67k</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="#627EEA"><path d="M12 1.5l-7 11.2L12 16l7-3.3L12 1.5z" opacity="0.6"/><path d="M5 12.7L12 22.5l7-9.8-7 3.3-7-3.3z"/></svg>
      ETH <span class="text-green-400">▲2.1%</span> <span class="text-green-400">$3.4k</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none"><linearGradient id="sol-g" x1="0" y1="0" x2="24" y2="24"><stop offset="0%" stop-color="#00FFA3"/><stop offset="100%" stop-color="#9945FF"/></linearGradient><path d="M4 16.5h14.5l-2.5 3H1.5l2.5-3zm0-5h14.5l-2.5 3H1.5l2.5-3zM16 4.5H1.5l2.5-3H18.5L16 4.5z" fill="url(#sol-g)"/></svg>
      SOL <span class="text-red-400">▼0.5%</span> <span class="text-red-400">$142</span>
    </div>
    <div class="ab-ticker-item flex items-center gap-1.5">
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="#FF9900"><path d="M6.7 17.5c-2.3-1.3-3.7-3.5-3.7-6C3 7.9 7 5 12 5s9 2.9 9 6.5c0 2.5-1.4 4.7-3.7 6" stroke="#FF9900" stroke-width="1.5" fill="none"/><path d="M14 13l4 2.5-4 2.5v-5z"/></svg>
      AMZN <span class="text-green-400">▲1.6%</span> <span class="text-green-400">$186</span>
    </div>
  </div>

  <!-- Mini bar chart (right) -->
  <svg class="ab-chart-2 absolute right-12 top-[45%] h-[70px] w-[90px] opacity-[0.08]" viewBox="0 0 90 70" fill="none">
    <rect x="0" y="0" width="90" height="70" rx="6" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
    <text x="5" y="10" fill="currentColor" font-size="5" font-family="monospace" opacity="0.5">Revenue Q4</text>
    <rect x="8" y="45" width="8" height="18" rx="1" fill="currentColor" opacity="0.2"/>
    <rect x="20" y="35" width="8" height="28" rx="1" fill="currentColor" opacity="0.25"/>
    <rect x="32" y="28" width="8" height="35" rx="1" fill="currentColor" opacity="0.3"/>
    <rect x="44" y="20" width="8" height="43" rx="1" fill="currentColor" opacity="0.35"/>
    <rect x="56" y="22" width="8" height="41" rx="1" fill="currentColor" opacity="0.3"/>
    <rect x="68" y="15" width="8" height="48" rx="1" fill="currentColor" opacity="0.4"/>
  </svg>

  <!-- Robot following path (right) -->
  <svg class="ab-robot-2 absolute right-[60px] top-[62%] h-[180px] w-[100px] opacity-[0.08]" viewBox="0 0 100 180" fill="none">
    <path d="M90,10 C90,60 10,40 10,90 C10,140 90,120 90,170" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3" opacity="0.4"/>
    <g opacity="0.6">
      <animateMotion dur="10s" repeatCount="indefinite" path="M90,10 C90,60 10,40 10,90 C10,140 90,120 90,170"/>
      <rect x="-7" y="-9" width="14" height="12" rx="3" stroke="currentColor" stroke-width="1" fill="none"/>
      <circle cx="-2.5" cy="-4" r="1.2" fill="currentColor"/>
      <circle cx="2.5" cy="-4" r="1.2" fill="currentColor"/>
      <line x1="-3" y1="-0.5" x2="3" y2="-0.5" stroke="currentColor" stroke-width="0.7"/>
    </g>
  </svg>

  <!-- Candlestick mini chart (right bottom) -->
  <svg class="ab-chart-3 absolute right-8 bottom-[18%] h-[65px] w-[110px] opacity-[0.07]" viewBox="0 0 110 65" fill="none">
    <rect x="0" y="0" width="110" height="65" rx="6" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
    <text x="5" y="10" fill="currentColor" font-size="5" font-family="monospace" opacity="0.5">ETH/USDT</text>
    <!-- Candlesticks -->
    <line x1="12" y1="20" x2="12" y2="50" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="9" y="28" width="6" height="12" fill="currentColor" opacity="0.2"/>
    <line x1="24" y1="15" x2="24" y2="45" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="21" y="18" width="6" height="15" fill="currentColor" opacity="0.15"/>
    <line x1="36" y1="22" x2="36" y2="52" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="33" y="30" width="6" height="14" fill="currentColor" opacity="0.25"/>
    <line x1="48" y1="18" x2="48" y2="48" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="45" y="22" width="6" height="16" fill="currentColor" opacity="0.2"/>
    <line x1="60" y1="12" x2="60" y2="42" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="57" y="16" width="6" height="14" fill="currentColor" opacity="0.15"/>
    <line x1="72" y1="14" x2="72" y2="44" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="69" y="20" width="6" height="12" fill="currentColor" opacity="0.2"/>
    <line x1="84" y1="10" x2="84" y2="40" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="81" y="14" width="6" height="16" fill="currentColor" opacity="0.25"/>
    <line x1="96" y1="8" x2="96" y2="38" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
    <rect x="93" y="12" width="6" height="14" fill="currentColor" opacity="0.2"/>
  </svg>

  <!-- ═══ FLOATING AI TERMS ═══ -->
  <div class="ab-term ab-float-1 absolute left-[3%] top-[42%] font-mono text-[10px] font-bold tracking-widest opacity-[0.09]">
    RAG
    <span class="block text-[7px] font-normal tracking-normal opacity-60">Retrieval Augmented Generation</span>
  </div>

  <div class="ab-term ab-float-2 absolute right-[4%] top-[32%] font-mono text-[9px] font-semibold tracking-wider opacity-[0.08]">
    Vector Search
  </div>

  <div class="ab-term ab-float-3 absolute left-[2%] top-[72%] font-mono text-[8px] font-semibold tracking-wider opacity-[0.08]">
    Embeddings
  </div>

  <div class="ab-term ab-float-4 absolute right-[3%] top-[78%] font-mono text-[10px] font-bold tracking-widest opacity-[0.08]">
    LLM
    <span class="block text-[7px] font-normal tracking-normal opacity-60">Large Language Model</span>
  </div>

  <div class="ab-term ab-float-5 absolute left-[5%] top-[88%] font-mono text-[8px] font-semibold tracking-wider opacity-[0.07]">
    Fine-tuning
  </div>

  <div class="ab-term ab-float-6 absolute right-[5%] top-[88%] font-mono text-[8px] font-semibold tracking-wider opacity-[0.07]">
    Inference
  </div>

  <div class="ab-term ab-float-7 absolute left-[4%] top-[55%] font-mono text-[8px] font-semibold tracking-wider opacity-[0.07]">
    Tokenization
  </div>

  <div class="ab-term ab-float-8 absolute right-[2%] top-[55%] font-mono text-[9px] font-bold tracking-widest opacity-[0.08]">
    pgvector
    <span class="block text-[7px] font-normal tracking-normal opacity-60">Similarity Search</span>
  </div>

  <div class="ab-term ab-float-9 absolute left-[6%] top-[30%] font-mono text-[8px] font-semibold tracking-wider opacity-[0.07]">
    Prompt Engineering
  </div>

  <div class="ab-term ab-float-10 absolute right-[6%] top-[22%] font-mono text-[8px] font-semibold tracking-wider opacity-[0.07]">
    RLHF
  </div>

  <!-- Hydroponics data readouts -->
  <div class="ab-hydro ab-float-11 absolute left-[1%] top-[82%] font-mono text-[8px] opacity-[0.07]">
    <div class="mb-0.5 font-bold tracking-wider">HYDRO-CTRL</div>
    <div>pH: 6.2 <span class="text-green-500">OK</span></div>
    <div>EC: 1.8 mS/cm</div>
    <div>Temp: 22.4°C</div>
    <div>Humidity: 68%</div>
  </div>

  <div class="ab-hydro ab-float-12 absolute right-[1%] top-[92%] font-mono text-[8px] opacity-[0.07]">
    <div class="mb-0.5 font-bold tracking-wider">GROWTH-AI</div>
    <div>Day: 14/21</div>
    <div>Height: 8.2cm</div>
    <div>Yield est: 94%</div>
  </div>
</div>

<style>
  /* Floating animation keyframes */
  @keyframes ab-float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }

  @keyframes ab-float-slow {
    0%, 100% { transform: translateY(0px) translateX(0px); }
    33% { transform: translateY(-8px) translateX(3px); }
    66% { transform: translateY(4px) translateX(-3px); }
  }

  @keyframes ab-drift {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-6px) rotate(0.5deg); }
  }

  @keyframes ab-ticker-scroll {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  @keyframes ab-pulse {
    0%, 100% { opacity: 0.04; }
    50% { opacity: 0.08; }
  }

  @keyframes ab-fade-in-out {
    0%, 100% { opacity: 0; }
    20%, 80% { opacity: 1; }
  }

  .ab-float-1 { animation: ab-float 6s ease-in-out infinite; }
  .ab-float-2 { animation: ab-float-slow 8s ease-in-out infinite 1s; }
  .ab-float-3 { animation: ab-float 7s ease-in-out infinite 2s; }
  .ab-float-4 { animation: ab-float-slow 9s ease-in-out infinite 0.5s; }
  .ab-float-5 { animation: ab-float 5s ease-in-out infinite 3s; }
  .ab-float-6 { animation: ab-float-slow 7s ease-in-out infinite 1.5s; }
  .ab-float-7 { animation: ab-float 8s ease-in-out infinite 4s; }
  .ab-float-8 { animation: ab-float-slow 6s ease-in-out infinite 2.5s; }
  .ab-float-9 { animation: ab-float 9s ease-in-out infinite 1s; }
  .ab-float-10 { animation: ab-float-slow 7s ease-in-out infinite 3.5s; }
  .ab-float-11 { animation: ab-drift 10s ease-in-out infinite; }
  .ab-float-12 { animation: ab-drift 8s ease-in-out infinite 2s; }

  .ab-sankey { animation: ab-drift 12s ease-in-out infinite; }
  .ab-robot { animation: ab-pulse 6s ease-in-out infinite; }
  .ab-robot-2 { animation: ab-pulse 8s ease-in-out infinite 3s; }

  .ab-chart-1 { animation: ab-fade-in-out 10s ease-in-out infinite; }
  .ab-chart-2 { animation: ab-fade-in-out 12s ease-in-out infinite 4s; }
  .ab-chart-3 { animation: ab-fade-in-out 14s ease-in-out infinite 7s; }

  .ab-ticker {
    animation: ab-ticker-scroll 30s linear infinite;
  }

  .ab-ticker-item {
    white-space: nowrap;
    padding: 2px 0;
  }

  /* Only show on wide screens (xl = 1280px+) */
  @media (max-width: 1279px) {
    #ai-background { display: none !important; }
  }

  /* Scale down on medium-wide screens */
  @media (min-width: 1280px) and (max-width: 1919px) {
    #ai-background { opacity: 0.8; }
    .ab-sankey { left: 0; }
  }
</style>
